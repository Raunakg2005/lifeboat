# Copy to .env and fill in. Never commit .env.
# Secrets (server/scripts only; never prefix a secret with VITE_)
DEV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# Sepolia + mainnet (read-only RPCs are fine)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# EIP-8141 alt-mempool devnet (chain 1337): ethrex node, skandha miner sidecar, gateway sidecar, explorer
ALT_MEMPOOL_RPC_URL=https://altmempool.forshtat.com
ALT_MEMPOOL_CHAIN_ID=1337
ALT_MEMPOOL_GATEWAY_URL=https://altmempoolgateway.forshtat.com/rpc
ALT_MEMPOOL_EXPLORER_URL=https://explorer.altmempool.wtf

# Frames Devnet 2 (bogota-devnet-2), not used by default
FRAME_DEVNET_RPC_URL=https://rpc.bogota-devnet-2.ethpandaops.io
FRAME_DEVNET_CHAIN_ID=7076692741

# Arkiv Rabdi testnet
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
